# ================================================================
#  VIBEZ PROTOCOL — Environment Variables
#  Author: Oyeyemi Olamilekan
#
#  INSTRUCTIONS:
#  1. Make a copy of this file and rename it to: .env
#  2. Fill in every value marked with 🔑
#  3. NEVER push your .env file to GitHub
# ================================================================


# ── DATABASE ────────────────────────────────────────────────────
# Local development — SQLite requires zero setup.
# NOTE: SQLite is for local only. On a hosted platform the filesystem is
# wiped on every redeploy, so a SQLite file there loses all data.
DATABASE_URL=sqlite:///./vibezprotocol.db

# 🔑 PRODUCTION — paste the connection string from your Postgres provider.
#    Set this in the host's dashboard (Render/Vercel env vars), NOT in a file.
#    Neon:   postgresql://user:pass@ep-xxx.aws.neon.tech/dbname?sslmode=require
#    Render: postgresql://user:pass@dpg-xxx.oregon-postgres.render.com/dbname
#    Supabase (use the pooled :6543 URL, not the direct :5432 one)
#
#    Managed Postgres requires TLS — keep ?sslmode=require if the provider
#    includes it. A "postgres://" prefix is fine, the app rewrites it.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require


# ── SECURITY ────────────────────────────────────────────────────
# 🔑 Replace with a long random secret. Generate one by running:
#    python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=🔑-PASTE-YOUR-GENERATED-SECRET-KEY-HERE


# ── GMAIL (Contact Form Email Notifications) ────────────────────
# When someone submits the contact form, you get an email here.
# 🔑 Steps to get your Gmail App Password:
#    1. Go to myaccount.google.com
#    2. Security → 2-Step Verification (enable if not done)
#    3. Search "App Passwords" → Create one for "Mail"
#    4. Copy the 16-character password below (no spaces)
GMAIL_USER=vibezprotocol@gmail.com
GMAIL_APP_PASSWORD=🔑-YOUR-16-CHARACTER-GMAIL-APP-PASSWORD


# ── ADMIN SETUP ─────────────────────────────────────────────────
# Used ONCE to create your admin account after first deploy.
# 🔑 Change this to anything private before deploying.
#    After running /api/auth/setup once, you can leave it as-is.
SETUP_SECRET=🔑-CHOOSE-A-PRIVATE-SETUP-KEY
